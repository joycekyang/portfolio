---
import { getCollection } from 'astro:content';
import SectionLayout from '../layouts/SectionLayout.astro';

const gdProjects = await getCollection('projects', ({ data }) => data.category === 'gd' && data.listed !== false);
---

<SectionLayout
  title="All Graphic Design Projects | Joyce Yang"
  heading="Featured Projects"
  projects={gdProjects}
/>
