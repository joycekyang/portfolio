---
import { getCollection } from 'astro:content';
import SectionLayout from '../layouts/SectionLayout.astro';

const uxProjects = await getCollection('projects', ({ data }) => data.category === 'uxd' && data.listed !== false);
---

<SectionLayout
  title="All UX Projects | Joyce Yang"
  heading="Featured Projects"
  projects={uxProjects}
/>
