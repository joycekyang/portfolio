---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import '../styles/tokens.css';

interface Props {
  title: string;
  description?: string;
  showNavbar?: boolean;
  showFooter?: boolean;
}

const {
  title,
  description = 'Portfolio of Joyce Yang: Instructional Designer, Learning Experience Designer, UX Designer, and Graphic Designer.',
  showNavbar = true,
  showFooter = true,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&family=Poppins:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    {showNavbar && <Navbar />}
    <main id="main-content" class="page-main">
      <slot />
    </main>
    {showFooter && <Footer />}
  </body>
</html>

<style>
  .page-main {
    flex: 1 0 auto;
    width: 100%;
    animation: pageEnter 0.25s ease-out;
  }

  @keyframes pageEnter {
    from {
      opacity: 0.92;
    }
    to {
      opacity: 1;
    }
  }
</style>
