---
import BaseLayout from './BaseLayout.astro';
import MetaGrid from '../components/MetaGrid.astro';
import ProjectCarousel, { type CarouselSlide } from '../components/ProjectCarousel.astro';
import { withBase } from '../utils/url';
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const {
  title,
  subtitle,
  category,
  description,
  image,
  imageAlt,
  transparentBg = true,
  tags,
  launchUrl,
  launchLabel = 'Launch Experience',
  secondaryLaunchUrl,
  secondaryLaunchLabel = 'Launch Course',
  extraLaunchLinks,
  youtubeEmbedUrl,
  figmaEmbedUrl,
  slidesEmbedUrl,
  slidesLabel = 'Presentation Deck',
  videoEmbeds,
  accentColor,
  meta,
  gallery,
  takeaways,
} = project.data;

const isUxdFlow = category === 'uxd';

const carouselSlides: CarouselSlide[] = [
  ...(isUxdFlow
    ? [
        {
          kind: 'image' as const,
          src: image,
          alt: imageAlt,
          label: 'App Showcase',
          transparentBg,
        },
      ]
    : []),
  ...(gallery || []).map((item) => ({
    kind: 'image' as const,
    src: item.src,
    alt: item.alt,
    label: item.label,
    caption: item.caption,
  })),
  ...(videoEmbeds || []).map((vid) => ({
    kind: 'embed' as const,
    src: vid.src,
    alt: vid.title,
    label: vid.title,
    caption: vid.caption,
    aspect: vid.aspect,
  })),
  ...(youtubeEmbedUrl
    ? [
        {
          kind: 'embed' as const,
          src: youtubeEmbedUrl,
          alt: `${title} Video Walkthrough`,
          label: 'Video Walkthrough',
          caption: 'Watch the walkthrough of this project.',
        },
      ]
    : []),
  ...(slidesEmbedUrl
    ? [
        {
          kind: 'embed' as const,
          src: slidesEmbedUrl,
          alt: `${title} Presentation Slides`,
          label: slidesLabel,
          caption: 'Click through the embedded presentation deck.',
          externalUrl: secondaryLaunchUrl,
          externalLabel: secondaryLaunchLabel,
        },
      ]
    : []),
];

const backMap = {
  lxd: { label: '← Back to Learning Experience Design', href: withBase('/all-lxd-projects') },
  uxd: { label: '← Back to User Experience Design', href: withBase('/all-ux-projects') },
  gd: { label: '← Back to Graphic Design', href: withBase('/all-graphic-design') },
};

const backLink = backMap[category];
---

<BaseLayout title={`${title} | Joyce Yang`} description={description} showNavbar={true} showFooter={true}>
  <article
    class={`case-study-wrapper ${isUxdFlow ? 'case-study-wrapper--uxd' : ''}`}
    style={accentColor ? `--primary-blue: ${accentColor};` : undefined}
  >
    <div class={`case-study-container ${isUxdFlow ? 'case-study-container--uxd' : ''}`}>
      {/* 1. Hero / Title Header Section (LXD & GD: Clean Desktop Cover Band with MetaGrid + Minimal Scroll Chevron) */}
      <div class={!isUxdFlow ? 'case-study-cover' : ''}>
        <section class={`hero-section ${isUxdFlow ? 'hero-section--uxd-compact' : ''}`}>
          {
            !isUxdFlow && (
              <div class="hero-image">
                <a
                  href={withBase(image)}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="hero-image-zoom gallery-zoom-trigger"
                  data-full-src={withBase(image)}
                  data-alt={imageAlt}
                  data-caption=""
                  aria-label={`Enlarge image: ${imageAlt}`}
                >
                  <img
                    src={withBase(image)}
                    alt={imageAlt}
                    class={!transparentBg ? 'hero-img--white-bg' : undefined}
                    loading="eager"
                    fetchpriority="high"
                    decoding="async"
                  />
                </a>
              </div>
            )
          }

          <div class="hero-content">
            <h1>{title}</h1>
            {subtitle && <h2>{subtitle}</h2>}
            <p>{description}</p>

            <div class={`hero-tags ${isUxdFlow ? 'hero-tags--uxd-row' : ''}`} aria-label="Skills and Tools Used">
              {tags.map((tag) => <span class="tag-pill">{tag}</span>)}
            </div>

            {
              !isUxdFlow && (launchUrl || secondaryLaunchUrl || (extraLaunchLinks && extraLaunchLinks.length > 0)) && (
                <div class="hero-cta-row">
                  {launchUrl && (
                    <a
                      href={withBase(launchUrl)}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="launch-btn"
                    >
                      {launchLabel} ↗
                    </a>
                  )}
                  {secondaryLaunchUrl && (
                    <a
                      href={withBase(secondaryLaunchUrl)}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="launch-btn launch-btn--secondary"
                    >
                      {secondaryLaunchLabel} ↗
                    </a>
                  )}
                  {extraLaunchLinks?.map((link) => (
                    <a
                      href={withBase(link.url)}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="launch-btn launch-btn--secondary"
                    >
                      {link.label} ↗
                    </a>
                  ))}
                </div>
              )
            }
          </div>
        </section>

        {/* 2. UXD Flow: Sleek Full-Width App Showcase Carousel Directly Below Title */}
        {isUxdFlow && carouselSlides.length > 0 && (
          <ProjectCarousel slides={carouselSlides} projectTitle={title} defaultLabel="App Showcase" />
        )}

        <!-- 5-Column Metadata Highlight Grid -->
        {meta && (
          <div class={isUxdFlow ? 'scroll-chapter' : ''} data-scroll-reveal={isUxdFlow ? '' : undefined}>
            <MetaGrid items={meta} />
          </div>
        )}
      </div>

      {/* 2B. LXD & Graphic Design Flow: Visual & Video Carousel After Cover Band, Before Overview */}
      {!isUxdFlow && carouselSlides.length > 0 && (
        <div id="case-study-next" class="case-study-chapter case-study-chapter--carousel" data-scroll-reveal>
          <ProjectCarousel slides={carouselSlides} projectTitle={title} defaultLabel="Project Visuals" />
        </div>
      )}

      <!-- Markdown Case Study Body (Overview & Details) -->
      <div
        id={!isUxdFlow && carouselSlides.length === 0 ? 'case-study-next' : undefined}
        class="case-study-prose case-study-chapter"
        data-scroll-reveal
      >
        <slot />
      </div>

      {/* 3. Interactive Figma Prototype Right After Overview & User Flows (Owns its Launch CTA on UXD) */}
      {
        figmaEmbedUrl && (
          <section class="embed-section case-study-chapter" aria-label="Interactive Figma Prototype" data-scroll-reveal>
            <div class="section-header-row">
              <h2 class="gallery-heading">Interactive Prototype</h2>
              {isUxdFlow && launchUrl && (
                <a
                  href={withBase(launchUrl)}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="launch-btn launch-btn--inline"
                >
                  {launchLabel} ↗
                </a>
              )}
            </div>
            <div class="responsive-iframe">
              <iframe
                src={figmaEmbedUrl}
                title={`${title} Interactive Figma Prototype`}
                loading="lazy"
                allowfullscreen
              />
            </div>
          </section>
        )
      }

      {/* 4. Takeaways at the Very End */}
      {
        takeaways && takeaways.length > 0 && (
          <section class="takeaways-section case-study-chapter" aria-label="Project Takeaways" data-scroll-reveal>
            <h2 class="gallery-heading">Takeaways</h2>
            <div class="takeaways-prose">
              {takeaways.map((paragraph) => (
                <p>{paragraph}</p>
              ))}
            </div>
          </section>
        )
      }

      <footer class="case-study-bottom-nav">
        <a href={backLink.href} class="outline-back-btn">{backLink.label}</a>
      </footer>
    </div>

    <!-- Natural-Resolution Lightbox Modal -->
    <div
      id="gallery-lightbox"
      class="lightbox-backdrop"
      role="dialog"
      aria-modal="true"
      aria-label="Enlarged Project Visual"
      hidden
    >
      <div class="lightbox-toolbar">
        <a
          id="lightbox-new-tab"
          href="#"
          target="_blank"
          rel="noopener noreferrer"
          class="lightbox-action-btn"
        >
          Open in New Tab ↗
        </a>
        <button
          id="lightbox-close"
          type="button"
          class="lightbox-close-btn"
          aria-label="Close enlarged image (Esc)"
        >
          ✕ Close
        </button>
      </div>

      <figure class="lightbox-figure">
        <img id="lightbox-img" src="" alt="" class="lightbox-img" />
        <figcaption id="lightbox-caption" class="lightbox-caption"></figcaption>
      </figure>
    </div>
  </article>
</BaseLayout>

<script>
  /**
   * Automatically detects the native aspect ratio (vertical vs. landscape & exact width/height)
   * of Google Drive video embeds via Google Drive's thumbnail endpoint so videos never show huge black bars.
   */
  function autoSizeVideoEmbeds() {
    const cards = document.querySelectorAll<HTMLElement>('.video-embed-card[data-video-src]');
    cards.forEach((card) => {
      const src = card.dataset.videoSrc || '';
      const match = src.match(/\/file\/d\/([^/]+)/);
      if (!match) return;

      const fileId = match[1];
      const frameBox = card.querySelector<HTMLElement>('.responsive-iframe');
      if (!frameBox) return;

      const probe = new Image();
      probe.onload = () => {
        if (probe.naturalWidth > 0 && probe.naturalHeight > 0) {
          const isVertical = probe.naturalHeight > probe.naturalWidth;
          card.classList.toggle('video-embed-card--vertical', isVertical);
          frameBox.classList.toggle('responsive-iframe--vertical', isVertical);
          frameBox.style.paddingBottom = `${((probe.naturalHeight / probe.naturalWidth) * 100).toFixed(2)}%`;
        }
      };
      probe.src = `https://drive.google.com/thumbnail?id=${fileId}&sz=w800`;
    });
  }

  autoSizeVideoEmbeds();

  /**
   * Natural-Resolution Lightbox for Project Visuals & Screens:
   * - Opens on click (while preserving Cmd/Ctrl+Click to open in a new tab).
   * - Caps image display width/height at 100% of its native pixel resolution so it never stretches or blurs.
   */
  function initGalleryLightbox() {
    const lightbox = document.getElementById('gallery-lightbox');
    const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement | null;
    const lightboxCaption = document.getElementById('lightbox-caption');
    const lightboxNewTab = document.getElementById('lightbox-new-tab') as HTMLAnchorElement | null;
    const closeBtn = document.getElementById('lightbox-close');
    const triggers = document.querySelectorAll<HTMLAnchorElement>('.gallery-zoom-trigger');

    if (!lightbox || !lightboxImg || !triggers.length) return;

    // Mount at document.body root so the modal always layers above sticky headers
    if (lightbox.parentElement !== document.body) {
      document.body.appendChild(lightbox);
    }

    function openLightbox(src: string, alt: string, caption: string, thumbImg?: HTMLImageElement | null) {
      if (!lightbox || !lightboxImg) return;

      // Apply natural resolution cap immediately if thumbnail is already loaded
      if (thumbImg && thumbImg.naturalWidth > 0) {
        lightboxImg.style.maxWidth = `min(92vw, ${thumbImg.naturalWidth}px)`;
        lightboxImg.style.maxHeight = `min(82vh, ${thumbImg.naturalHeight}px)`;
      } else {
        lightboxImg.style.maxWidth = '92vw';
        lightboxImg.style.maxHeight = '82vh';
      }

      lightboxImg.onload = () => {
        if (lightboxImg.naturalWidth > 0) {
          lightboxImg.style.maxWidth = `min(92vw, ${lightboxImg.naturalWidth}px)`;
          lightboxImg.style.maxHeight = `min(82vh, ${lightboxImg.naturalHeight}px)`;
        }
      };

      lightboxImg.src = src;
      lightboxImg.alt = alt;
      if (lightboxCaption) {
        lightboxCaption.textContent = caption || alt;
      }
      if (lightboxNewTab) {
        lightboxNewTab.href = src;
      }

      lightbox.hidden = false;
      document.body.style.overflow = 'hidden';
      closeBtn?.focus();
    }

    function closeLightbox() {
      if (!lightbox || !lightboxImg) return;
      lightbox.hidden = true;
      lightboxImg.src = '';
      document.body.style.overflow = '';
    }

    triggers.forEach((trigger) => {
      trigger.addEventListener('click', (e) => {
        // Allow Cmd/Ctrl+Click or middle-click to open directly in a new tab
        if (e.metaKey || e.ctrlKey || e.shiftKey || e.button === 1) return;
        e.preventDefault();
        const src = trigger.dataset.fullSrc || trigger.href;
        const alt = trigger.dataset.alt || '';
        const caption = trigger.dataset.caption || '';
        const thumbImg = trigger.querySelector('img');
        openLightbox(src, alt, caption, thumbImg);
      });
    });

    closeBtn?.addEventListener('click', closeLightbox);

    lightbox.addEventListener('click', (e) => {
      // Close when clicking the dark backdrop outside the image/toolbar
      if (e.target === lightbox || (e.target as HTMLElement).classList.contains('lightbox-figure')) {
        closeLightbox();
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !lightbox.hidden) {
        closeLightbox();
      }
    });
  }

  function initScrollExperience() {
    // Buttery scroll-triggered micro-reveals for below-the-fold chapters
    const revealItems = document.querySelectorAll<HTMLElement>('[data-scroll-reveal]');
    if (!revealItems.length) return;

    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReduced || !('IntersectionObserver' in window)) {
      revealItems.forEach((el) => el.classList.add('is-revealed'));
      return;
    }

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-revealed');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.08, rootMargin: '0px 0px -40px 0px' }
    );

    revealItems.forEach((el) => {
      el.classList.add('reveal-ready');
      observer.observe(el);
    });
  }

  initGalleryLightbox();
  initScrollExperience();
</script>

<style>
  .case-study-wrapper {
    background: var(--bg-surface);
    padding: 40px 20px 88px 20px;
  }

  .case-study-wrapper--uxd {
    padding-top: 20px;
  }

  .case-study-container {
    max-width: 1280px;
    margin: 0 auto;
    background: var(--card-bg);
    border-radius: 20px;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.04);
    padding: 52px 68px;
  }

  .case-study-container--uxd {
    padding: 32px 60px 52px 60px;
  }

  .breadcrumb-nav {
    margin-bottom: 32px;
  }

  .back-link {
    font-family: var(--font-heading);
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--primary-blue);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    transition: transform 0.2s ease;
  }

  .back-link:hover {
    transform: translateX(-4px);
    text-decoration: underline;
  }

  /* Hero Section */
  .hero-section {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 56px;
    align-items: center;
    margin-bottom: 48px;
  }

  .hero-section--uxd-compact {
    display: block;
    margin-bottom: 18px;
  }

  .hero-section--uxd-compact .hero-content {
    width: 100%;
    max-width: 860px;
  }

  .hero-section--uxd-compact .hero-content h1 {
    font-size: clamp(1.9rem, 3.4vw, 2.5rem);
    margin-bottom: 6px;
  }

  .hero-section--uxd-compact .hero-content h2 {
    font-size: 1.06rem;
    margin-bottom: 8px;
  }

  .hero-section--uxd-compact .hero-content p {
    font-size: 0.98rem;
    line-height: 1.55;
    margin-bottom: 0;
  }

  .hero-tags--uxd-row {
    margin-top: 12px;
    margin-bottom: 0;
  }

  .section-header-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 14px;
    margin-bottom: 20px;
  }

  .section-header-row .gallery-heading {
    margin: 0;
  }

  .launch-btn--inline {
    padding: 9px 18px;
    font-size: 0.88rem;
    border-radius: 9px;
  }

  /* Takeaways Section (Bottom of UXD Flow) */
  .takeaways-section {
    margin-top: 48px;
    padding-top: 36px;
    border-top: 1px solid var(--border-subtle);
  }

  .takeaways-prose p {
    font-size: 1.04rem;
    line-height: 1.8;
    color: var(--text-muted);
    margin: 0 0 18px 0;
  }

  .takeaways-prose p:last-child {
    margin-bottom: 0;
  }

  .hero-image {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .hero-image-zoom {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    cursor: zoom-in;
    text-decoration: none;
  }

  .hero-image img {
    width: 100%;
    max-height: 420px;
    object-fit: contain;
    border-radius: 12px;
    filter: drop-shadow(0 14px 32px rgba(0, 0, 0, 0.12));
    transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .hero-image-zoom:hover img {
    transform: scale(1.018);
  }

  /* Desktop First-Screen Cover Band + Native Proximity Snap (Zero Scroll-Hijacking, Desktop Only) */
  @media (min-width: 1024px) and (min-height: 760px) {
    :global(html) {
      scroll-snap-type: y proximity;
      scroll-behavior: smooth;
    }

    .case-study-wrapper:not(.case-study-wrapper--uxd) {
      padding-top: 24px;
    }

    .case-study-container:not(.case-study-container--uxd) {
      padding-top: 36px;
    }

    .case-study-cover {
      min-height: calc(100vh - 156px);
      display: flex;
      flex-direction: column;
      justify-content: center;
      scroll-snap-align: start;
      scroll-margin-top: 120px;
    }

    .case-study-cover .hero-section {
      margin-bottom: 24px;
    }

    .case-study-cover .hero-image img {
      max-height: 360px;
    }

    .case-study-cover :global(.meta-grid) {
      margin: 0;
      padding: 20px 0 0 0;
    }

    .case-study-chapter--carousel {
      scroll-snap-align: start;
    }
  }

  /* Distinct Visual Chapter Rhythm & Buttery Scroll Micro-Reveals */
  .case-study-chapter--carousel {
    scroll-margin-top: 96px;
    padding-top: 40px;
    margin-top: 12px;
    border-top: 1px solid var(--border-subtle);
  }

  .case-study-prose.case-study-chapter {
    scroll-margin-top: 96px;
  }

  [data-scroll-reveal].reveal-ready {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.65s cubic-bezier(0.22, 1, 0.36, 1), transform 0.65s cubic-bezier(0.22, 1, 0.36, 1);
  }

  [data-scroll-reveal].reveal-ready.is-revealed {
    opacity: 1;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html) {
      scroll-snap-type: none;
      scroll-behavior: auto;
    }
    [data-scroll-reveal].reveal-ready {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }

  .hero-image img.hero-img--white-bg {
    filter: none;
    mix-blend-mode: multiply;
  }

  .hero-content h1 {
    font-size: clamp(2.1rem, 4vw, 3rem);
    color: var(--primary-blue);
    font-weight: 800;
    margin-bottom: 12px;
    letter-spacing: -0.02em;
    line-height: 1.12;
  }

  .hero-content h2 {
    font-size: 1.25rem;
    color: var(--text-muted);
    font-weight: 600;
    margin-bottom: 20px;
    line-height: 1.4;
  }

  .hero-content p {
    font-size: 1.05rem;
    color: var(--text-muted);
    line-height: 1.78;
    margin-bottom: 20px;
  }

  .hero-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 24px;
  }

  .tag-pill {
    background: var(--primary-blue-soft);
    color: var(--primary-blue);
    padding: 5px 14px;
    border-radius: var(--radius-pill);
    font-family: var(--font-heading);
    font-size: 12.5px;
    font-weight: 600;
  }

  .hero-cta-row {
    margin-top: 8px;
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }

  .launch-btn,
  .launch-btn--secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    background: #ffffff;
    color: var(--primary-blue);
    border: 2px solid var(--primary-blue);
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.92rem;
    padding: 12px 20px;
    border-radius: 10px;
    text-decoration: none;
    max-width: 100%;
    text-align: center;
    white-space: normal;
    transition: transform 0.25s ease, background-color 0.25s ease, color 0.25s ease, box-shadow 0.25s ease;
  }

  .launch-btn:hover,
  .launch-btn--secondary:hover {
    background: var(--primary-blue);
    color: #ffffff;
    transform: translateY(-2px);
    box-shadow: 0 8px 22px var(--primary-blue-shadow);
  }

  /* Case Study Prose */
  .case-study-prose {
    border-top: 1px solid var(--border-subtle);
    padding-top: 40px;
    font-size: 1.04rem;
    line-height: 1.8;
    color: var(--text-main);
  }

  .case-study-prose :global(h2) {
    font-size: 1.65rem;
    color: var(--primary-blue);
    font-weight: 800;
    margin: 36px 0 14px 0;
  }

  .case-study-prose :global(h2:first-child) {
    margin-top: 0;
  }

  .case-study-prose :global(h3) {
    font-size: 1.25rem;
    color: var(--text-pure-black);
    font-weight: 700;
    margin: 28px 0 10px 0;
  }

  .case-study-prose :global(p) {
    margin: 0 0 18px 0;
    color: var(--text-muted);
  }

  .case-study-prose :global(ul),
  .case-study-prose :global(ol) {
    margin: 0 0 24px 0;
    padding-left: 24px;
    color: var(--text-muted);
  }

  .case-study-prose :global(li) {
    margin-bottom: 12px;
  }

  .case-study-prose :global(strong) {
    color: var(--text-pure-black);
    font-weight: 700;
  }

  /* Gallery */
  .gallery-section {
    margin-top: 48px;
    padding-top: 40px;
    border-top: 1px solid var(--border-subtle);
  }

  .gallery-heading {
    font-size: 1.5rem;
    color: var(--primary-blue);
    font-weight: 800;
    margin-bottom: 24px;
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 28px;
  }

  .gallery-item {
    margin: 0;
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: 14px;
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    transition: transform 0.25s var(--ease-smooth), box-shadow 0.25s var(--ease-smooth), border-color 0.25s ease;
  }

  .gallery-item:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-card);
    border-color: rgba(51, 33, 255, 0.25);
  }

  .gallery-zoom-trigger {
    position: relative;
    display: block;
