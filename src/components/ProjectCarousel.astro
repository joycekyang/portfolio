---
import { withBase } from '../utils/url';

export interface CarouselSlide {
  kind?: 'image' | 'embed';
  src: string;
  alt: string;
  label?: string;
  caption?: string;
  transparentBg?: boolean;
  aspect?: 'landscape' | 'vertical';
  externalUrl?: string;
  externalLabel?: string;
}

interface Props {
  slides: CarouselSlide[];
  projectTitle: string;
  defaultLabel?: string;
}

const { slides, projectTitle, defaultLabel = 'App Showcase' } = Astro.props;
const firstSlide = slides[0];
---

<section class="carousel-showcase" aria-label={`${projectTitle} Visual Showcase Carousel`}>
  <!-- Minimal Editorial Header Bar -->
  <div class="carousel-meta-bar">
    <span class="carousel-active-label" data-carousel-label>
      {firstSlide?.label || defaultLabel}
    </span>
    <div class="carousel-meta-right">
      <a
        href={firstSlide?.externalUrl ? withBase(firstSlide.externalUrl) : '#'}
        target="_blank"
        rel="noopener noreferrer"
        class={`carousel-ext-link ${!firstSlide?.externalUrl ? 'is-hidden' : ''}`}
        data-carousel-ext-link
      >
        {firstSlide?.externalLabel || 'Open in New Tab'} ↗
      </a>
      {
        slides.length > 1 && (
          <span class="carousel-counter" data-carousel-counter aria-live="polite">
            1 / {slides.length}
          </span>
        )
      }
    </div>
  </div>

  <!-- Sleek Single-Surface Stage with Silky Horizontal Track -->
  <div class="carousel-stage">
    <div class="carousel-track" data-carousel-track>
      {
        slides.map((slide, idx) => {
          const isEmbed = slide.kind === 'embed';
          const fullSrc = isEmbed ? slide.src : withBase(slide.src);
          const extHref = slide.externalUrl ? withBase(slide.externalUrl) : '';
          return (
            <div
              class={`carousel-slide ${isEmbed ? 'carousel-slide--embed' : ''}`}
              data-slide-index={idx}
              data-slide-kind={isEmbed ? 'embed' : 'image'}
              data-slide-label={slide.label || defaultLabel}
              data-slide-caption={slide.caption || ''}
              data-slide-ext-url={extHref}
              data-slide-ext-label={slide.externalLabel || ''}
              aria-hidden={idx === 0 ? 'false' : 'true'}
            >
              {isEmbed ? (
                <div
                  class={`carousel-embed-frame ${slide.aspect === 'vertical' ? 'carousel-embed-frame--vertical' : ''}`}
                  data-video-src={fullSrc}
                >
                  <iframe
                    src={fullSrc}
                    data-embed-src={fullSrc}
                    title={slide.alt}
                    loading="eager"
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; fullscreen"
                    allowfullscreen
                  />
                </div>
              ) : (
                <a
                  href={fullSrc}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="carousel-image-link gallery-zoom-trigger"
                  data-full-src={fullSrc}
                  data-alt={slide.alt}
                  data-caption={slide.caption || slide.label || slide.alt}
                  aria-label={`Click to enlarge: ${slide.alt}`}
                >
                  <img
                    src={fullSrc}
                    alt={slide.alt}
                    class="carousel-img"
                    loading="eager"
                    fetchpriority={idx === 0 ? 'high' : 'auto'}
                    decoding="async"
                  />
                  <span class="zoom-pill" aria-hidden="true">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                      <polyline points="15 3 21 3 21 9" />
                      <polyline points="9 21 3 21 3 15" />
                      <line x1="21" y1="3" x2="14" y2="10" />
                      <line x1="3" y1="21" x2="10" y2="14" />
                    </svg>
                    <span>Zoom</span>
                  </span>
                </a>
              )}
            </div>
          );
        })
      }
    </div>

    <!-- Whisper-Clean Frosted Glass Chevron Controls -->
    {
      slides.length > 1 && (
        <>
          <button
            type="button"
            class="carousel-chevron carousel-chevron--prev"
            aria-label="Previous visual"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="15 18 9 12 15 6" />
            </svg>
          </button>
          <button
            type="button"
            class="carousel-chevron carousel-chevron--next"
            aria-label="Next visual"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="9 18 15 12 9 6" />
            </svg>
          </button>
        </>
      )
    }
  </div>

  <!-- Concise Caption + Compact Apple/Linear Morphing Pill Dots -->
  <div class="carousel-footer">
    <p
      class={`carousel-caption ${!slides[0]?.caption ? 'is-empty' : ''}`}
      data-carousel-caption
      aria-live="polite"
    >
      {slides[0]?.caption || ''}
    </p>

    {
      slides.length > 1 && (
        <div class="carousel-dots" role="tablist" aria-label="Choose visual slide">
          {slides.map((slide, idx) => (
            <button
              type="button"
              role="tab"
              class={`carousel-dot ${idx === 0 ? 'is-active' : ''}`}
              data-dot-index={idx}
              aria-selected={idx === 0 ? 'true' : 'false'}
              aria-label={`Show slide ${idx + 1}: ${slide.label || slide.alt}`}
            />
          ))}
        </div>
      )
    }
  </div>
</section>

<script>
  function initProjectCarousels() {
    const carousels = document.querySelectorAll<HTMLElement>('.carousel-showcase');
    carousels.forEach((carousel) => {
      const track = carousel.querySelector<HTMLElement>('[data-carousel-track]');
      const slides = carousel.querySelectorAll<HTMLElement>('.carousel-slide');
      const dots = carousel.querySelectorAll<HTMLButtonElement>('.carousel-dot');
      const prevBtn = carousel.querySelector<HTMLButtonElement>('.carousel-chevron--prev');
      const nextBtn = carousel.querySelector<HTMLButtonElement>('.carousel-chevron--next');
      const labelEl = carousel.querySelector<HTMLElement>('[data-carousel-label]');
      const counterEl = carousel.querySelector<HTMLElement>('[data-carousel-counter]');
      const captionEl = carousel.querySelector<HTMLElement>('[data-carousel-caption]');
      const extLinkEl = carousel.querySelector<HTMLAnchorElement>('[data-carousel-ext-link]');

      // Auto-detect native aspect ratio for Google Drive video embeds inside carousel
      const embedFrames = carousel.querySelectorAll<HTMLElement>('.carousel-embed-frame[data-video-src]');
      embedFrames.forEach((frame) => {
        const src = frame.dataset.videoSrc || '';
        const match = src.match(/drive\.google\.com\/file\/d\/([a-zA-Z0-9_-]+)/);
        if (!match) return;
        const probe = new Image();
        probe.onload = () => {
          if (probe.naturalWidth > 0 && probe.naturalHeight > 0) {
            const isVertical = probe.naturalHeight > probe.naturalWidth;
            frame.classList.toggle('carousel-embed-frame--vertical', isVertical);
            frame.style.aspectRatio = `${probe.naturalWidth} / ${probe.naturalHeight}`;
          }
        };
        probe.src = `https://drive.google.com/thumbnail?id=${match[1]}&sz=w800`;
      });

      if (!track || slides.length <= 1) return;

      let currentIndex = 0;

      function goToSlide(index: number) {
        const prevIndex = currentIndex;
        currentIndex = (index + slides.length) % slides.length;
        track!.style.transform = `translate3d(-${currentIndex * 100}%, 0, 0)`;

        // Stop background audio when leaving a video slide, while keeping Figma/Slides embeds preloaded
        if (prevIndex !== currentIndex) {
          const prevIframe = slides[prevIndex]?.querySelector<HTMLIFrameElement>('iframe[data-embed-src]');
          const embedSrc = prevIframe?.dataset.embedSrc || '';
          if (prevIframe && /youtube\.com|drive\.google\.com/i.test(embedSrc)) {
            prevIframe.setAttribute('src', embedSrc);
          }
        }

        const activeSlide = slides[currentIndex];
        const nextLabel = activeSlide?.dataset.slideLabel || `Visual ${currentIndex + 1}`;
        const nextCaption = activeSlide?.dataset.slideCaption || '';
        const nextExtUrl = activeSlide?.dataset.slideExtUrl || '';
        const nextExtLabel = activeSlide?.dataset.slideExtLabel || 'Open in New Tab';

        if (labelEl) labelEl.textContent = nextLabel;
        if (counterEl) counterEl.textContent = `${currentIndex + 1} / ${slides.length}`;
        if (extLinkEl) {
          if (nextExtUrl) {
            extLinkEl.href = nextExtUrl;
            extLinkEl.textContent = `${nextExtLabel} ↗`;
            extLinkEl.classList.remove('is-hidden');
          } else {
            extLinkEl.classList.add('is-hidden');
          }
        }
        if (captionEl) {
          captionEl.textContent = nextCaption;
          captionEl.classList.toggle('is-empty', !nextCaption);
        }

        slides.forEach((slide, idx) => {
          slide.setAttribute('aria-hidden', idx === currentIndex ? 'false' : 'true');
        });
        dots.forEach((dot, idx) => {
          const isActive = idx === currentIndex;
          dot.classList.toggle('is-active', isActive);
          dot.setAttribute('aria-selected', isActive ? 'true' : 'false');
        });
      }

      prevBtn?.addEventListener('click', () => goToSlide(currentIndex - 1));
      nextBtn?.addEventListener('click', () => goToSlide(currentIndex + 1));

      dots.forEach((dot) => {
        dot.addEventListener('click', () => {
          const idx = Number(dot.dataset.dotIndex || '0');
          goToSlide(idx);
        });
      });

      // Keyboard Left / Right navigation
      carousel.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowLeft') {
          e.preventDefault();
          goToSlide(currentIndex - 1);
        } else if (e.key === 'ArrowRight') {
          e.preventDefault();
          goToSlide(currentIndex + 1);
        }
      });

      // Touch swipe support for mobile & tablet
      let touchStartX = 0;
      track.addEventListener(
        'touchstart',
        (e) => {
          touchStartX = e.changedTouches[0]?.clientX || 0;
        },
        { passive: true }
      );
      track.addEventListener(
        'touchend',
        (e) => {
          const deltaX = (e.changedTouches[0]?.clientX || 0) - touchStartX;
          if (Math.abs(deltaX) > 48) {
            goToSlide(deltaX < 0 ? currentIndex + 1 : currentIndex - 1);
          }
        },
        { passive: true }
      );
    });
  }

  initProjectCarousels();
</script>

<style>
  .carousel-showcase {
    margin: 0 0 48px 0;
  }

  /* Minimal Top Label + Tabular Counter */
  .carousel-meta-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 12px;
    padding: 0 4px;
  }

  .carousel-active-label {
    font-family: var(--font-heading);
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--primary-blue);
  }

  .carousel-meta-right {
    display: inline-flex;
    align-items: center;
    gap: 16px;
  }

  .carousel-ext-link {
    font-family: var(--font-heading);
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--primary-blue);
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .carousel-ext-link:hover {
    text-decoration: underline;
  }

  .carousel-ext-link.is-hidden {
    display: none;
  }

  .carousel-counter {
    font-family: var(--font-heading);
    font-size: 0.8rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    color: var(--text-subtle);
  }

  /* Single Clean Tonal Stage (No Nested Box Clutter) */
  .carousel-stage {
    position: relative;
    width: 100%;
    overflow: hidden;
    border-radius: 18px;
    background: linear-gradient(180deg, #fafbff 0%, #f4f6fb 100%);
    border: 1px solid rgba(15, 23, 42, 0.06);
  }

  .carousel-track {
    display: flex;
    width: 100%;
    transition: transform 0.62s cubic-bezier(0.22, 1, 0.36, 1);
    will-change: transform;
  }

  .carousel-slide {
    flex: 0 0 100%;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 22px 68px;
    height: clamp(320px, 51vh, 470px);
    background: linear-gradient(180deg, #fafbff 0%, #f4f6fb 100%);
  }

  .carousel-slide--embed {
    padding: 20px 76px;
  }

  .carousel-embed-frame {
    position: relative;
    height: 100%;
    max-width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: 12px;
    overflow: hidden;
    background: #0f172a;
    box-shadow: 0 12px 32px rgba(15, 23, 42, 0.12);
  }

  .carousel-embed-frame--vertical {
    aspect-ratio: 9 / 16;
    height: 100%;
    width: auto;
  }

  .carousel-embed-frame iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .carousel-image-link {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    cursor: zoom-in;
    text-decoration: none;
  }

  .carousel-img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    display: block;
    border-radius: 8px;
    mix-blend-mode: multiply;
    transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .carousel-image-link:hover .carousel-img {
    transform: scale(1.015);
  }

  /* Subtle Frosted Zoom Pill (Reveals cleanly on hover) */
  .zoom-pill {
    position: absolute;
    bottom: 6px;
    right: 6px;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    background: rgba(15, 23, 42, 0.72);
    backdrop-filter: blur(10px);
    color: #ffffff;
    font-family: var(--font-heading);
    font-size: 11.5px;
    font-weight: 600;
    letter-spacing: 0.02em;
    padding: 6px 12px;
    border-radius: 999px;
    opacity: 0;
    transform: translateY(4px);
    transition: opacity 0.22s ease, transform 0.22s ease, background-color 0.2s ease;
    pointer-events: none;
  }

  .carousel-image-link:hover .zoom-pill,
  .carousel-image-link:focus-visible .zoom-pill {
    opacity: 1;
    transform: translateY(0);
  }

  /* Whisper-Clean Frosted Glass Chevron Controls */
  .carousel-chevron {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.84);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(15, 23, 42, 0.09);
    color: var(--text-main);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    box-shadow: 0 4px 16px rgba(15, 23, 42, 0.07);
    opacity: 0.78;
    transition:
      opacity 0.25s ease,
      transform 0.25s cubic-bezier(0.22, 1, 0.36, 1),
      background-color 0.2s ease,
      color 0.2s ease,
      border-color 0.2s ease,
      box-shadow 0.25s ease;
    z-index: 5;
  }

  .carousel-stage:hover .carousel-chevron {
    opacity: 1;
  }

  .carousel-chevron--prev {
    left: 16px;
  }

  .carousel-chevron--next {
    right: 16px;
  }

  .carousel-chevron:hover {
    background: #ffffff;
    color: var(--primary-blue);
    border-color: rgba(51, 33, 255, 0.28);
    box-shadow: 0 8px 24px rgba(51, 33, 255, 0.14);
    transform: translateY(-50%) scale(1.06);
  }

  .carousel-chevron:active {
    transform: translateY(-50%) scale(0.96);
  }

  /* Editorial Caption + Morphing Pill Dots */
  .carousel-footer {
    margin-top: 16px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
  }

  .carousel-caption {
    margin: 0;
    font-size: 0.94rem;
    line-height: 1.55;
    color: var(--text-muted);
    text-align: center;
    max-width: 720px;
    transition: opacity 0.25s ease;
  }

  .carousel-caption.is-empty {
    display: none;
  }

  .carousel-dots {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
  }

  .carousel-dot {
    width: 7px;
    height: 7px;
    padding: 0;
    border-radius: 999px;
    border: none;
    background: rgba(15, 23, 42, 0.18);
    cursor: pointer;
    transition: width 0.35s cubic-bezier(0.22, 1, 0.36, 1), background-color 0.25s ease;
  }

  .carousel-dot:hover {
    background: rgba(51, 33, 255, 0.45);
  }

  .carousel-dot.is-active {
    width: 26px;
    background: var(--primary-blue);
  }

  @media (max-width: 640px) {
    .carousel-slide {
      padding: 18px 46px;
      height: 280px;
    }

    .carousel-slide--embed {
      padding: 16px 46px;
    }

    .carousel-embed-frame {
      width: 100%;
      height: auto;
      max-height: 100%;
    }

    .carousel-chevron {
      width: 34px;
      height: 34px;
    }

    .carousel-chevron--prev {
      left: 8px;
    }

    .carousel-chevron--next {
      right: 8px;
    }
  }
</style>
